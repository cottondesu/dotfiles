# .gitconfig

[user]
	name = {{ .name }}
	email = {{ .email }}

[core]
	editor = vim

[push]
	autoSetupRemote = true

[fetch]
	prune = true

[alias]
    # -- 基本操作 --
    s = status -sb
    co = checkout
    cm = commit -m
    ca = commit --amend --no-edit
    br = branch -vv

    # -- 差分・ログ --
    df = diff
    dc = diff --cached
    lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
    last = log -1 HEAD --stat

    # -- 取消・やり直し --
    unstage = reset HEAD --
    # zsh環境での挙動を安定させるため HEAD^ ではなく HEAD~1 を使用
    uncommit = reset --soft HEAD~1
    undo = reset --hard HEAD~1

    # -- ユーティリティ --
    root = rev-parse --show-toplevel
    # 不要になった（マージ済み）ローカルブランチを一括削除
    clean-merged = !git branch --merged | grep -v '\\*\\|main\\|master\\|develop' | xargs -I % git branch -d %
    # assume-unchanged（一時的な無視）に設定したファイルを確認
    assumed = !git ls-files -v | grep '^[[:lower:]]'